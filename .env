APP_NAME=Enterprise CBT SaaS Kampus
APP_ENV=production
APP_PORT=8080
APP_BASE_URL=https://cbt.example.edu
FRONTEND_URL=https://cbt.example.edu
DATABASE_URL=postgres://cbt:cbt_password@postgres:5432/cbt?sslmode=disable
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=cbt
POSTGRES_USER=cbt
POSTGRES_PASSWORD=cbt_password
POSTGRES_MAX_CONNS=80
POSTGRES_MIN_CONNS=10
POSTGRES_READ_DATABASE_URL=postgres://cbt:cbt_password@postgres-read:5432/cbt?sslmode=disable
REDIS_ADDR=redis:6379
REDIS_PASSWORD=redis_password
REDIS_DB=0
REDIS_CLUSTER_ADDRS=
RABBITMQ_URL=amqp://cbt:cbt_password@rabbitmq:5672/
JWT_ACCESS_SECRET=change-me-access-secret-64-bytes-minimum
JWT_REFRESH_SECRET=change-me-refresh-secret-64-bytes-minimum
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_HOURS=720
PASSWORD_PEPPER=change-me-password-pepper
REQUEST_SIGNING_SECRET=change-me-signing-secret
REQUEST_SIGNING_REQUIRED=false
ENCRYPTION_KEY=change-me-32-byte-key-for-aes-gcm
BCRYPT_COST=12
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_SECONDS=60
LOGIN_RATE_LIMIT_MAX=10
CORS_ALLOWED_ORIGINS=https://cbt.example.edu,http://localhost:5173
COOKIE_DOMAIN=.example.edu
CSRF_SECRET=change-me-csrf-secret
IP_WHITELIST=
S3_ENDPOINT=minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=cbt-assets
S3_REGION=us-east-1
S3_USE_SSL=false
SENTRY_DSN=
PROMETHEUS_ENABLED=true
LOKI_URL=http://loki:3100
TRACING_ENDPOINT=http://otel-collector:4317
BACKUP_BUCKET=cbt-backups
BACKUP_RETENTION_DAYS=30
WAL_ARCHIVE_ENABLED=true
MAX_CONCURRENT_USERS=100000
FEATURE_FREE_MAX_STUDENTS=100
FEATURE_BASIC_MAX_STUDENTS=1000
FEATURE_PROFESSIONAL_MAX_STUDENTS=10000
FEATURE_ENTERPRISE_MAX_STUDENTS=100000
