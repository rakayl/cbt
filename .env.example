# Copy to .env and rotate every secret before production
APP_NAME=Enterprise CBT SaaS Kampus
APP_ENV=production
APP_PORT=8080
APP_BASE_URL=https://cbt.example.edu
FRONTEND_URL=https://cbt.example.edu
DATABASE_URL=postgres://cbt:strong-password@postgres:5432/cbt?sslmode=require
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=cbt
POSTGRES_USER=cbt
POSTGRES_PASSWORD=strong-password
POSTGRES_MAX_CONNS=80
POSTGRES_MIN_CONNS=10
POSTGRES_READ_DATABASE_URL=postgres://cbt:strong-password@postgres-read:5432/cbt?sslmode=require
REDIS_ADDR=redis:6379
REDIS_PASSWORD=strong-redis-password
REDIS_DB=0
REDIS_CLUSTER_ADDRS=redis-0.redis:6379,redis-1.redis:6379,redis-2.redis:6379
RABBITMQ_URL=amqp://cbt:strong-password@rabbitmq:5672/
JWT_ACCESS_SECRET=replace-with-64-byte-random-secret
JWT_REFRESH_SECRET=replace-with-different-64-byte-random-secret
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_HOURS=720
PASSWORD_PEPPER=replace-with-random-pepper
REQUEST_SIGNING_SECRET=replace-with-random-signing-secret
REQUEST_SIGNING_REQUIRED=false
ENCRYPTION_KEY=replace-with-32-byte-key
BCRYPT_COST=12
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_SECONDS=60
LOGIN_RATE_LIMIT_MAX=10
CORS_ALLOWED_ORIGINS=https://cbt.example.edu
COOKIE_DOMAIN=.example.edu
CSRF_SECRET=replace-with-csrf-secret
IP_WHITELIST=
S3_ENDPOINT=s3.amazonaws.com
S3_ACCESS_KEY=replace-me
S3_SECRET_KEY=replace-me
S3_BUCKET=cbt-assets
S3_REGION=ap-southeast-3
S3_USE_SSL=true
SENTRY_DSN=
PROMETHEUS_ENABLED=true
LOKI_URL=http://loki:3100
TRACING_ENDPOINT=http://otel-collector:4317
BACKUP_BUCKET=cbt-backups
BACKUP_RETENTION_DAYS=30
WAL_ARCHIVE_ENABLED=true
MAX_CONCURRENT_USERS=100000
FEATURE_FREE_MAX_STUDENTS=100
FEATURE_BASIC_MAX_STUDENTS=1000
FEATURE_PROFESSIONAL_MAX_STUDENTS=10000
FEATURE_ENTERPRISE_MAX_STUDENTS=100000
